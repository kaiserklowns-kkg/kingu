{
	"$schema": "vscode://schemas/color-theme",
	"name": "Oceans Dark",
	"include": "./dark_modern.json",
	"colors": {
		"focusBorder": "#2AA8C4",
		"foreground": "#C9D6E3",
		"descriptionForeground": "#8197AD",
		"widget.border": "#1E3247",
		"titleBar.activeBackground": "#0A1724",
		"titleBar.inactiveBackground": "#0A1724",
		"titleBar.border": "#1E3247",
		"activityBar.background": "#0A1724",
		"activityBar.border": "#1E3247",
		"activityBar.activeBorder": "#2AA8C4",
		"sideBar.background": "#0C1B2A",
		"sideBar.border": "#1E3247",
		"sideBarSectionHeader.background": "#0C1B2A",
		"editor.background": "#0E2032",
		"editor.foreground": "#D5E2EE",
		"editor.lineHighlightBackground": "#14293D",
		"editor.selectionBackground": "#1F4E6E",
		"editorGroupHeader.tabsBackground": "#0C1B2A",
		"tab.activeBackground": "#0E2032",
		"tab.inactiveBackground": "#0C1B2A",
		"tab.border": "#1E3247",
		"tab.activeBorderTop": "#2AA8C4",
		"panel.background": "#0C1B2A",
		"panel.border": "#1E3247",
		"statusBar.background": "#0A1724",
		"statusBar.border": "#1E3247",
		"input.background": "#0A1724",
		"input.border": "#1E3247",
		"button.background": "#1D7F99",
		"button.hoverBackground": "#2394B2",
		"badge.background": "#1D7F99",
		"list.activeSelectionBackground": "#1F4E6E",
		"list.inactiveSelectionBackground": "#163A54",
		"list.hoverBackground": "#13293D",
		"terminal.background": "#0C1B2A"
	},
	"tokenColors": [
		{ "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#5F7E99", "fontStyle": "italic" } },
		{ "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#5FC4DC" } },
		{ "scope": ["string", "string.quoted"], "settings": { "foreground": "#9CD8B4" } },
		{ "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#F2C98A" } },
		{ "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#F29B8A" } }
	]
}
