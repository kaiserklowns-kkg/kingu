{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kingu",
  "identifier": "ai.anthov.kingu.studio",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cargo build -p kingu-ptyd -p kingu-cli && bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Kingu",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; frame-src kingu-artifact: http://kingu-artifact.localhost kingu-snap-view: http://kingu-snap-view.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Code editor and AI agent workspace",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "signingIdentity": "-",
      "entitlements": "entitlements/app.plist"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
