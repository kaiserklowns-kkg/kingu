<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the agent host sidecar (Contents/MacOS/kingu-agent-host, a `bun build
  compile` executable). JavaScriptCore needs MAP_JIT under the hardened runtime: without
  allow-jit the sidecar dies at startup ("SharedArrayBuffer is not defined"). Nothing else:
  no allow-unsigned-executable-memory, disable-library-validation or
  allow-dyld-environment-variables (docs/PLAN.md 7.2).
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
